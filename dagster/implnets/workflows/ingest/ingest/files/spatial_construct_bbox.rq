PREFIX schema: <https://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX sf: <http://www.opengis.net/ont/sf#>

CONSTRUCT {
  ?geo geo:hasGeometry ?geometry .
  ?geometry a sf:Polygon .
  ?geometry geo:asWKT ?wktBbox .
}
WHERE {
  ?s a schema:Dataset .
  ?s schema:spatialCoverage ?spatialcoverage .
  ?spatialcoverage schema:geo ?geo .
  ?geo a schema:GeoShape .
  ?geo schema:box ?coordString .

  # schema:box is "minLat minLong maxLat maxLong". Separators vary in the wild
  # (space, comma, comma+space), so normalise to single spaces and drop any
  # language tag before parsing.
  BIND(REPLACE(REPLACE(STR(?coordString), ",", " "), "\\s+", " ") AS ?spaced)
  BIND(REPLACE(?spaced, "^ | $", "") AS ?norm)

  # Only accept exactly four numeric values; anything else must not produce a
  # geometry at all, rather than a WKT literal full of empty slots.
  FILTER(REGEX(?norm, "^[+-]?[0-9]*\\.?[0-9]+( [+-]?[0-9]*\\.?[0-9]+){3}$"))

  BIND(STRBEFORE(?norm, " ") AS ?minLat)
  BIND(STRAFTER(?norm, " ") AS ?rest1)
  BIND(STRBEFORE(?rest1, " ") AS ?minLong)
  BIND(STRAFTER(?rest1, " ") AS ?rest2)
  BIND(STRBEFORE(?rest2, " ") AS ?maxLat)
  BIND(STRAFTER(?rest2, " ") AS ?maxLong)

  # nabu skolemises blank nodes into https://gleaner.io/xid/genid/... IRIs, so in
  # every release checked ?geo is an IRI and STR(?geo) is well defined -- that is
  # the branch that runs, and it keeps the geometry IRIs byte identical to what
  # is already published. Should an unskolemised release ever turn up, STR() of a
  # blank node is a type error in SPARQL: rdflib tolerated it and minted invalid
  # relative IRIs like <N793220240ebb.../geometry>, a spec compliant engine drops
  # the solution and emits no geometry at all. The fallback keys off the dataset
  # IRI instead, hashing the normalised box so one dataset can hold several
  # boxes. IF only evaluates the branch it takes, so STR(?geo) is never reached
  # for a blank node.
  BIND(
    IF(isIRI(?geo),
       CONCAT(STR(?geo), "/geometry"),
       CONCAT(STR(?s), "/geometry/bbox/", MD5(?norm))
    ) AS ?geometryIri
  )
  BIND(IRI(?geometryIri) AS ?geometry)

  # WKT is x y == longitude latitude, counter-clockwise from the lower-left.
  BIND(
    STRDT(
      CONCAT(
        "POLYGON((",
        ?minLong, " ", ?minLat, ", ",
        ?maxLong, " ", ?minLat, ", ",
        ?maxLong, " ", ?maxLat, ", ",
        ?minLong, " ", ?maxLat, ", ",
        ?minLong, " ", ?minLat, "))"
      ), geo:wktLiteral
    ) AS ?wktBbox
  )
}
